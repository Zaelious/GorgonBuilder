{
  "name": "gorgon-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "npm run typecheck && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run worker:types && tsc --noEmit && tsc --noEmit --project scripts/tsconfig.json && tsc --noEmit --project worker/tsconfig.json",
    "test": "vitest run",
    "data:update": "node --use-env-proxy scripts/data-update.ts",
    "deploy": "npm run build && wrangler deploy",
    "preview:cloudflare": "npm run build && wrangler preview",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "worker:types": "wrangler types worker/worker-configuration.d.ts",
    "worker:dev": "npm run db:migrate:local && wrangler dev --env local",
    "worker:smoke": "node scripts/worker-smoke.ts",
    "ui:smoke:t0020": "node scripts/t0020-browser-smoke.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --env local --local",
    "db:migrations:list:local": "wrangler d1 migrations list DB --env local --local",
    "data:generate": "node --experimental-transform-types --import ./scripts/typescript-imports.ts scripts/data-generate.ts",
    "coverage:treasure": "node --import ./scripts/typescript-imports.ts scripts/treasure-coverage.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "better-auth": "1.7.18",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.156.0"
  }
}
