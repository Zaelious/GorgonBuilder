{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gorgonbuilder",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
